file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${PROGRAM}" --json pp.json WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "pp export failed: ${output} ${error}")
endif()
file(READ "${WORK}/pp.json" data)
string(JSON schema GET "${data}" schema)
string(JSON claim GET "${data}" claim_status)
string(JSON bound GET "${data}" numerical_bound)
string(JSON b GET "${data}" B_d_MeV)
string(JSON s GET "${data}" S_pp_0_MeV_b)
string(JSON rows LENGTH "${data}" radial)
string(JSON columns LENGTH "${data}" radial 0)
string(JSON config GET "${data}" resolved_configuration)
string(JSON provenance GET "${data}" git_commit)
if(NOT schema STREQUAL "kin6d-pp-fusion-v1" OR NOT claim STREQUAL "candidate")
    message(FATAL_ERROR "export schema or scientific claim changed")
endif()
if(NOT bound MATCHES "unavailable" OR b LESS 2.2245 OR b GREATER 2.2247)
    message(FATAL_ERROR "bound status or binding energy is incorrect")
endif()
if(rows LESS 500 OR NOT columns EQUAL 11 OR NOT config MATCHES "PP_FUSION")
    message(FATAL_ERROR "incomplete radial data or configuration")
endif()
if(NOT EXISTS "${WORK}/output/pp_fusion_export.nc" OR provenance STREQUAL "unavailable")
    message(FATAL_ERROR "missing native result or provenance")
endif()
# Low energies beyond the declared domain must fail, not emit partial data.
file(WRITE "${WORK}/invalid.nml" "&pp_fusion energy=-1 /\n")
execute_process(COMMAND "${PROGRAM}" --config invalid.nml WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(invalid EQUAL 0)
    message(FATAL_ERROR "invalid fusion input accepted")
endif()
message(STATUS "Valid JSON and native result: ${rows} rows, B=${b}, S=${s}")
