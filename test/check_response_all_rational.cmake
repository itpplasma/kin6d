# Exercise the application, including rational discovery, layer meshing and solve.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/coils.txt"
    "1\nloop 4\n8 -1 -0.5\n8 1 -0.5\n8 1 0.5\n8 -1 0.5\n")
file(WRITE "${WORK}/currents.txt" "1000.0\n")
foreach(mode automatic explicit)
    set(rationals "rat_num(1)=2, rat_den(1)=1, rat_auto=.true.,")
    if(mode STREQUAL explicit)
        set(rationals "rat_num(1)=2, rat_den(1)=1, rat_num(2)=3, rat_den(2)=1, rat_num(3)=99, rat_den(3)=1, rat_auto=.false.,")
    endif()
    file(WRITE "${WORK}/${mode}.nml"
        "&l4 eqdsk='${EQDSK}', coils='coils.txt', currents(1)='currents.txt', prefix='${mode}', n=1, ${rationals} nrad=12, nth_max=64, order=2, nphi=32, nfine=256, np_sample=64, model='ideal', closure='frobenius', layer_delta=0.02, layer_ratio=2, zero_pressure=.true., error_estimate=.false., gmres_tol=1e-9, gmres_maxit=400 /\n")
    execute_process(COMMAND "${APP}" "${mode}.nml" WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 85)
    file(WRITE "${WORK}/${mode}.log" "${out}${err}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${mode} Frobenius response failed: ${out}${err}")
    endif()
    if(NOT out MATCHES "ideal response: info 0,")
        message(FATAL_ERROR "${mode} Frobenius solve did not converge: ${out}")
    endif()
    if(mode STREQUAL automatic AND NOT out MATCHES "added, rat_auto")
        message(FATAL_ERROR "automatic Frobenius closure omitted the sideband rational")
    endif()
    # Identical rationals, ordering, mesh and physical drive give the same data.
    file(STRINGS "${WORK}/${mode}_res.dat" rows REGEX "^[^#].*")
    list(LENGTH rows count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "${mode}: expected both q=2 and q=3 response rows")
    endif()
    if(mode STREQUAL automatic)
        set(automatic_rows "${rows}")
    elseif(NOT "${rows}" STREQUAL "${automatic_rows}")
        message(FATAL_ERROR "automatic and explicit all-rational responses differ")
    endif()
endforeach()
