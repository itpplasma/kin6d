# App contract of gs_free: namelist forward solve with refit, outputs and provenance,
# --evaluate reuse, the three coil-inverse fit variants on twin data, input rejection.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(NCDUMP ncdump REQUIRED)
set(common "boundary_file='boundary.dat', boundary_nodes=48, degree=2, coil_file='coils.txt', profile_file='profile.dat', plasma_ellipse=3.0,0.7,1.0, chain_nodes=24, lcfs_mode='limiter', points_file='limiter.dat', axis_guess=3.0,0.0, search_radius=0.5, seed_amplitude=0.5, max_refits=3")

function(run_app dir input expect_ok)
    file(MAKE_DIRECTORY "${WORK}/${dir}")
    foreach(name boundary.dat coils.txt profile.dat limiter.dat)
        file(COPY "${FIXTURES}/${name}" DESTINATION "${WORK}/${dir}")
    endforeach()
    file(WRITE "${WORK}/${dir}/input.nml" "&gs_free ${common}, ${input} /\n")
    execute_process(COMMAND "${APP}" --config input.nml WORKING_DIRECTORY "${WORK}/${dir}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
    set(app_out "${out}${err}" PARENT_SCOPE)
    if(expect_ok AND NOT status EQUAL 0)
        message(FATAL_ERROR "gs_free ${dir} failed: ${out}${err}")
    endif()
    if(NOT expect_ok AND status EQUAL 0)
        message(FATAL_ERROR "gs_free ${dir} accepted invalid input")
    endif()
endfunction()

function(nc_value file name result)
    execute_process(COMMAND "${NCDUMP}" -v ${name} "${file}"
        OUTPUT_VARIABLE data RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "independent NetCDF reader failed on ${name}")
    endif()
    string(REGEX MATCH "[\n ]${name} = ([^;]+);" match "${data}")
    if(NOT match)
        message(FATAL_ERROR "missing result variable ${name}")
    endif()
    string(REGEX REPLACE "[ \n,]+" ";" values "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "^;|;$" "" values "${values}")
    set(${result} "${values}" PARENT_SCOPE)
endfunction()

find_package(Python3 REQUIRED COMPONENTS Interpreter)
function(require_near what a b tolerance)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -I -c
        "import sys; sys.exit(0 if abs(float(sys.argv[1])-float(sys.argv[2])) <= float(sys.argv[3]) else 1)"
        "${a}" "${b}" "${tolerance}" RESULT_VARIABLE near_status)
    if(NOT near_status EQUAL 0)
        message(FATAL_ERROR "${what}: ${a} differs from ${b} by more than ${tolerance}")
    endif()
endfunction()

function(summary_value file name result)
    file(STRINGS "${file}" lines REGEX "^${name} ")
    string(REGEX REPLACE "^${name} +" "" value "${lines}")
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

# 1. Forward solve with refit.
run_app(forward "currents=-10000.0,0.0" TRUE)
set(nc "${WORK}/forward/output/gs_free.nc")
nc_value("${nc}" psi_bound psi_bound)
nc_value("${nc}" psi_axis psi_axis)
nc_value("${nc}" plasma_current ip)
nc_value("${nc}" refit_converged refit_converged)
nc_value("${nc}" refit_movement movement)
nc_value("${nc}" circuit_currents currents)
nc_value("${nc}" profile_f profile_f)
if(NOT refit_converged EQUAL 1)
    message(FATAL_ERROR "refit loop did not converge")
endif()
list(GET movement -1 final_movement)
if(NOT final_movement LESS 0.002)
    message(FATAL_ERROR "final chain distance ${final_movement} h not within tolerance")
endif()
if(NOT psi_axis GREATER psi_bound OR NOT ip GREATER 100000)
    message(FATAL_ERROR "forward equilibrium is not a plasma: psi_a=${psi_axis} psi_b=${psi_bound} Ip=${ip}")
endif()
list(GET currents 0 current_1)
require_near("circuit currents echoed" "${current_1}" -10000 0.1)
# Flux-surface readback on the plasma cells (psi = psi_b on the free boundary).
nc_value("${nc}" q_status q_status)
if(NOT q_status EQUAL 0)
    message(FATAL_ERROR "flux-surface readback failed, status ${q_status}")
endif()
nc_value("${nc}" q q_values)
nc_value("${nc}" q_s q_s)
nc_value("${nc}" toroidal_flux toroidal_flux)
list(LENGTH q_values q_count)
list(GET q_s 0 q_s_axis)
list(GET q_s -1 q_s_edge)
require_near("q levels start on the axis" "${q_s_axis}" 0 1e-12)
require_near("q levels end on the boundary" "${q_s_edge}" 1 1e-12)
if(q_count LESS 17 OR toroidal_flux EQUAL 0)
    message(FATAL_ERROR "q profile missing: ${q_count} levels, Phi=${toroidal_flux}")
endif()
execute_process(COMMAND "${NCDUMP}" -h "${nc}" OUTPUT_VARIABLE header)
foreach(attribute code_commit code_tree convention lcfs_mode coil_file profile_file omp_threads)
    if(NOT header MATCHES ":${attribute} = ")
        message(FATAL_ERROR "provenance attribute ${attribute} missing")
    endif()
endforeach()
foreach(output mesh.dat profile-law.dat summary.dat)
    if(NOT EXISTS "${WORK}/forward/${output}")
        message(FATAL_ERROR "missing output ${output}")
    endif()
endforeach()

# 2. --evaluate reuse: the flux at the magnetic axis reproduces psi_axis, single
# and streaming queries agree, F is the executed law inside and F_edge outside.
summary_value("${WORK}/forward/summary.dat" axis_R axis_r)
summary_value("${WORK}/forward/summary.dat" axis_Z axis_z)
summary_value("${WORK}/forward/summary.dat" psi_bound pb)
file(WRITE "${WORK}/forward/request.txt" "3\n${axis_r} ${axis_z}\n2.9 0.2\n3.9 0.0\n")
execute_process(COMMAND "${APP}" --evaluate mesh.dat 5 0 profile-law.dat ${pb}
    WORKING_DIRECTORY "${WORK}/forward" INPUT_FILE "${WORK}/forward/request.txt"
    OUTPUT_VARIABLE single RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "--evaluate failed")
endif()
string(REGEX MATCHALL "[-+0-9.]+E[-+][0-9]+" numbers "${single}")
list(LENGTH numbers count)
if(NOT count EQUAL 12)
    message(FATAL_ERROR "--evaluate returned ${count} numbers, not 12: ${single}")
endif()
list(GET numbers 0 psi_at_axis)
require_near("flux at the magnetic axis" "${psi_at_axis}" "${psi_axis}" 1e-4)
file(WRITE "${WORK}/forward/request2.txt" "3\n${axis_r} ${axis_z}\n2.9 0.2\n3.9 0.0\n0\n3\n${axis_r} ${axis_z}\n2.9 0.2\n3.9 0.0\n")
execute_process(COMMAND "${APP}" --evaluate-stream mesh.dat 5 0 profile-law.dat ${pb}
    WORKING_DIRECTORY "${WORK}/forward" INPUT_FILE "${WORK}/forward/request2.txt"
    OUTPUT_VARIABLE repeated RESULT_VARIABLE status TIMEOUT 20)
if(NOT status EQUAL 0 OR NOT repeated STREQUAL "${single}${single}")
    message(FATAL_ERROR "streaming changed a field response or failed to stop on EOF")
endif()

# 3. Coil-inverse twin: constraints are the flux at four points of the forward
# solution; every fit variant recovers the circuit currents from a displaced start.
file(WRITE "${WORK}/forward/points.txt" "4\n2.9 0.2\n3.2 -0.3\n2.6 0.0\n3.1 0.5\n")
execute_process(COMMAND "${APP}" --evaluate mesh.dat 5 0 profile-law.dat ${pb}
    WORKING_DIRECTORY "${WORK}/forward" INPUT_FILE "${WORK}/forward/points.txt"
    OUTPUT_VARIABLE twin RESULT_VARIABLE status)
string(REGEX MATCHALL "[-+0-9.]+E[-+][0-9]+" twin_numbers "${twin}")
set(rows "# kind R Z R2 Z2 target scale\n")
set(point_list "2.9;0.2;3.2;-0.3;2.6;0.0;3.1;0.5")
foreach(k 0 1 2 3)
    math(EXPR r_index "2*${k}")
    math(EXPR z_index "2*${k}+1")
    math(EXPR v_index "4*${k}")
    list(GET point_list ${r_index} r)
    list(GET point_list ${z_index} z)
    list(GET twin_numbers ${v_index} v)
    string(APPEND rows "psi_point ${r} ${z} 0 0 ${v} 1e-4\n")
endforeach()
foreach(variant bounded unconstrained fixed_at_limit)
    file(WRITE "${WORK}/rows.txt" "${rows}")
    file(COPY "${WORK}/rows.txt" DESTINATION "${WORK}/inv_${variant}")
    run_app(inv_${variant} "currents=-4000.0,0.0, fit='${variant}', constraints_file='rows.txt'" TRUE)
    set(nc "${WORK}/inv_${variant}/output/gs_free.nc")
    nc_value("${nc}" circuit_currents fitted)
    nc_value("${nc}" gsvd_values gsvd)
    nc_value("${nc}" fit_status fit_status)
    nc_value("${nc}" fit_phi fit_phi)
    list(GET fitted 0 i1)
    list(GET fitted 1 i2)
    list(LENGTH gsvd n_gsvd)
    require_near("${variant}: circuit 1 current" "${i1}" -10000 100)
    require_near("${variant}: circuit 2 current" "${i2}" 0 100)
    if(NOT n_gsvd EQUAL 2 OR NOT fit_phi LESS 0.01)
        message(FATAL_ERROR "${variant}: GSVD report or objective missing (${n_gsvd}, ${fit_phi})")
    endif()
    execute_process(COMMAND "${NCDUMP}" -h "${nc}" OUTPUT_VARIABLE header)
    if(NOT header MATCHES ":fit = \"${variant}\"")
        message(FATAL_ERROR "${variant}: fit variant not recorded in the provenance")
    endif()
endforeach()

# 4. Invalid input is rejected.
run_app(bad_mode "lcfs_mode='ellipse'" FALSE)
run_app(bad_fit "fit='newton'" FALSE)
run_app(bad_coils "coil_file='missing.txt'" FALSE)
file(REMOVE_RECURSE "${WORK}")
