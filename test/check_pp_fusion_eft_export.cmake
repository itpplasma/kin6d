file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${PROGRAM}" --json pp.json WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "EFT export failed: ${output} ${error}")
endif()
file(READ "${WORK}/pp.json" data)
string(JSON schema GET "${data}" schema)
string(JSON claim GET "${data}" claim_status)
string(JSON bound GET "${data}" numerical_bound)
string(JSON rows LENGTH "${data}" orders)
string(JSON inputs LENGTH "${data}" inputs)
string(JSON config GET "${data}" resolved_configuration)
string(JSON commit GET "${data}" git_commit)
string(JSON s GET "${data}" orders 6 S_pp_0_MeV_b)
string(JSON l GET "${data}" orders 6 Lambda2)
string(JSON slope GET "${data}" orders 6 S_prime_over_S_per_MeV)
string(JSON truncation GET "${data}" orders 6 truncation_S_estimate_MeV_b)
string(JSON lattice_error GET "${data}" orders 6 input_error_components L1A_EFT_matching_S_MeV_b)
if(lattice_error STREQUAL "0")
    message(FATAL_ERROR "lattice uncertainty missing")
endif()
string(JSON ft GET "${data}" ft_s)
if(NOT schema STREQUAL "kin6d-pp-fusion-eft-v1" OR NOT claim STREQUAL "candidate")
    message(FATAL_ERROR "wrong schema/claim")
endif()
if(NOT bound MATCHES "unavailable" OR NOT rows EQUAL 8 OR NOT inputs EQUAL 6)
    message(FATAL_ERROR "missing orders/inputs/bound status")
endif()
if(NOT config MATCHES "PP_FUSION_EFT" OR commit STREQUAL "unavailable")
    message(FATAL_ERROR "missing recoverable input or provenance")
endif()
if(l LESS 7.0202 OR l GREATER 7.0204 OR slope LESS 11.27 OR slope GREATER 11.29)
    message(FATAL_ERROR "incorrect default NNLO overlap/slope")
endif()
if(NOT ft EQUAL 3071.4)
    message(FATAL_ERROR "inconsistent weak normalization")
endif()
if(NOT EXISTS "${WORK}/output/pp_fusion_eft_export.nc")
    message(FATAL_ERROR "missing native result")
endif()
file(WRITE "${WORK}/invalid.nml" "&pp_fusion_eft rho_d=5 /\n")
execute_process(COMMAND "${PROGRAM}" --config invalid.nml --json rejected.json
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(invalid EQUAL 0 OR EXISTS "${WORK}/rejected.json")
    message(FATAL_ERROR "invalid pole residue accepted or partial JSON emitted")
endif()
message(STATUS "EFT JSON: Lambda2=${l}, S=${s}, slope=${slope}, truncation=${truncation}")
