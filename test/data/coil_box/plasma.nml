! Synthetic coil box at finite pressure: Gaussian heating about the axis
! R = 3 m, continuation to chi_par/chi_perp = g_par/g_perp = 1e3.
&box
 coils_file = 'coils.box', wall_file = 'wall.txt', extcur = 1.0e5,
 period = 2, nring = 6, ncore = 8, nthmax = 128, order = 2, modes = 4, map_modes = 2
/
&plasma
 axis_rc(0) = 3.0, source_peak = 5000.0, source_width = 0.15,
 chi_perp = 1.0, chi_ratio = 1.0e3, g_par = 1.0, g_ratio = 1.0e3, decades = 1,
 beta_range = 2.0e-3, 5.0e-3
/
