file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${DECK}" 2 --write-input WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "inverse input generation failed")
endif()
execute_process(COMMAND "${APP}" --config input.nml WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Phase 1 finite-pressure inverse failed: ${out}${err}")
endif()
file(WRITE "${WORK}/queries.dat" "3\n0.1\n0.5\n0.9\n")
execute_process(COMMAND "${APP}" --q profiles.dat WORKING_DIRECTORY "${WORK}"
    INPUT_FILE "${WORK}/queries.dat" OUTPUT_VARIABLE values RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "native inverse q readback failed")
endif()
string(REGEX MATCHALL "[-+0-9.]+E[-+][0-9]+" values "${values}")
foreach(q IN LISTS values)
    if(q LESS 1.499 OR q GREATER 1.501)
        message(FATAL_ERROR "inverse CLI returned wrong prescribed q: ${q}")
    endif()
endforeach()
list(LENGTH values count)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "native q readback omitted values")
endif()
find_program(NCDUMP ncdump REQUIRED)
execute_process(COMMAND "${NCDUMP}" -v prescribed_q,phi_target,inverse_q_error
    "${WORK}/output/gs_phase1.nc" OUTPUT_VARIABLE data RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR NOT data MATCHES "prescribed_q = 1.5, 1.5, 1.5, 1.5")
    message(FATAL_ERROR "inverse result lost the executed q input")
endif()
if(NOT EXISTS "${WORK}/profile-law.dat")
    message(FATAL_ERROR "inverse result omitted the solved source law")
endif()
