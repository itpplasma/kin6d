execute_process(COMMAND "${GS_REFERENCE_ERROR}" "${MESH}" "${PARAMETERS}" affine-p2
    RESULT_VARIABLE status OUTPUT_VARIABLE bounds ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native affine P2 enclosure failed: ${diagnostic}")
endif()
string(JSON order GET "${bounds}" element_order)
if(NOT order EQUAL 2)
    message(FATAL_ERROR "The enclosure did not use six-DOF P2 reconstruction")
endif()
file(WRITE "${OUTPUT}" "${bounds}")
message(STATUS "Saved whole-cell P2 bounds: ${OUTPUT}")
