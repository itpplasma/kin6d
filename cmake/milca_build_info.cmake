# Build-time provenance: regenerate the Fortran include on every build, but
# rewrite it only when the recorded revision, dirty state or build identity
# changed. Inputs (-D): MILCA_SOURCE_DIR, MILCA_INFO_OUTPUT and the
# MILCA_BUILD_* / MILCA_*_REVISION strings listed in milca_info_names below.
execute_process(COMMAND git -C "${MILCA_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE MILCA_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE commit_status ERROR_QUIET)
if(NOT commit_status EQUAL 0)
    set(MILCA_GIT_COMMIT "unavailable")
    set(MILCA_GIT_DIRTY "unavailable")
else()
    execute_process(COMMAND git -C "${MILCA_SOURCE_DIR}" status --porcelain
            --untracked-files=no
        OUTPUT_VARIABLE dirty_files OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE dirty_status ERROR_QUIET)
    if(NOT dirty_status EQUAL 0)
        set(MILCA_GIT_DIRTY "unavailable")
    elseif(dirty_files STREQUAL "")
        set(MILCA_GIT_DIRTY "clean")
    else()
        set(MILCA_GIT_DIRTY "dirty")
    endif()
endif()
set(MILCA_SOURCE_PATH "${MILCA_SOURCE_DIR}")
set(milca_info_names MILCA_GIT_COMMIT MILCA_GIT_DIRTY MILCA_SOURCE_PATH
    MILCA_BUILD_TYPE MILCA_BUILD_FLAGS MILCA_BUILD_COMPILER
    MILCA_FORTSYM_REVISION MILCA_FORTNUM_REVISION MILCA_FORTPLOT_REVISION
    MILCA_FORTIO_REVISION MILCA_FORTFEM_REVISION MILCA_FORTSPARSE_REVISION
    MILCA_LIBNEO_REVISION)
set(text "! Generated by cmake/milca_build_info.cmake; do not edit.\n")
foreach(name IN LISTS milca_info_names)
    string(TOLOWER "${name}" lower)
    set(value "${${name}}")
    string(APPEND text "character(len=*), parameter :: ${lower} = \"\"")
    string(LENGTH "${value}" remaining)
    set(offset 0)
    while(remaining GREATER 0)
        string(SUBSTRING "${value}" ${offset} 60 chunk)
        string(REPLACE "\"" "\"\"" chunk "${chunk}")
        string(APPEND text " // &\n    \"${chunk}\"")
        math(EXPR offset "${offset} + 60")
        math(EXPR remaining "${remaining} - 60")
    endwhile()
    string(APPEND text "\n")
endforeach()
if(EXISTS "${MILCA_INFO_OUTPUT}")
    file(READ "${MILCA_INFO_OUTPUT}" previous)
else()
    set(previous "")
endif()
if(NOT previous STREQUAL text)
    file(WRITE "${MILCA_INFO_OUTPUT}" "${text}")
endif()
