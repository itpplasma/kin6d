cmake_minimum_required(VERSION 3.22)

# Layering test (cmake -P). Checks
#  1. the Fortran use graph of every layered source against the partition in
#     PARTITION ("layer=source" lines written at configure time): a source uses
#     only modules of its own layer or of a lower layer; among the L2 model
#     classes only mhd uses equilibrium; no layer uses an application module;
#  2. that every registered test carries one class label and one tier label.
set(rank_core 0)
set(rank_fem2d 1)
set(rank_pairs 1)
foreach(class equilibrium mhd classical quantum continuum)
    set(rank_${class} 2)
endforeach()
set(rank_apps 3)
set(sideways_mhd equilibrium)

file(STRINGS "${PARTITION}" entries)
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "^([a-z0-9]+)=.*$" "\\1" layer "${entry}")
    string(REGEX REPLACE "^[a-z0-9]+=" "" source "${entry}")
    list(APPEND sources_${layer} "${source}")
    list(APPEND layers ${layer})
    file(STRINGS "${source}" lines REGEX
        "^[ \t]*[Mm][Oo][Dd][Uu][Ll][Ee][ \t]+[A-Za-z0-9_]+[ \t]*(!.*)?$")
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "^[ \t]*[A-Za-z]+[ \t]+([A-Za-z0-9_]+).*$" "\\1"
            module "${line}")
        string(TOLOWER "${module}" module)
        set(module_layer_${module} ${layer})
        set(module_source_${module} "${source}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES layers)

set(violations 0)
foreach(layer IN LISTS layers)
    if(layer STREQUAL "apps")
        continue()
    endif()
    foreach(source IN LISTS sources_${layer})
        # Number lines exactly: neutralise list separators and brackets first.
        file(READ "${source}" text)
        string(REGEX REPLACE "[];[]" " " text "${text}")
        string(REPLACE "\n" ";" lines "${text}")
        set(number 0)
        foreach(line IN LISTS lines)
            math(EXPR number "${number} + 1")
            if(NOT line MATCHES
                    "^[ \t]*([Uu][Ss][Ee]|[Ss][Uu][Bb][Mm][Oo][Dd][Uu][Ll][Ee])[ \t,:(]")
                continue()
            endif()
            string(REGEX REPLACE
                "^[ \t]*[A-Za-z]+[ \t]*(,[ \t]*[A-Za-z_]+[ \t]*)?(::)?[ \t(]*([A-Za-z0-9_]+).*$"
                "\\3" module "${line}")
            string(TOLOWER "${module}" module)
            if(NOT DEFINED module_layer_${module})
                continue()
            endif()
            set(used ${module_layer_${module}})
            if(used STREQUAL layer OR rank_${used} LESS rank_${layer})
                continue()
            endif()
            if(used IN_LIST sideways_${layer})
                continue()
            endif()
            message(SEND_ERROR "${source}:${number}: ${layer} uses ${module} "
                "of ${used} (${module_source_${module}})")
            math(EXPR violations "${violations} + 1")
        endforeach()
    endforeach()
endforeach()

execute_process(COMMAND ${CTEST} --show-only=json-v1
    WORKING_DIRECTORY ${BUILD_DIR} OUTPUT_VARIABLE json RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "ctest --show-only=json-v1 failed in ${BUILD_DIR}")
endif()
set(tiers fast slow regression performance)
set(unlabelled 0)
string(JSON count LENGTH "${json}" tests)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON name GET "${json}" tests ${index} name)
    set(labels)
    string(JSON nprops ERROR_VARIABLE missing LENGTH "${json}" tests ${index} properties)
    if(NOT missing)
        math(EXPR plast "${nprops} - 1")
        foreach(p RANGE ${plast})
            string(JSON pname GET "${json}" tests ${index} properties ${p} name)
            if(pname STREQUAL "LABELS")
                string(JSON value GET "${json}" tests ${index} properties ${p} value)
                string(JSON nl LENGTH "${value}")
                math(EXPR llast "${nl} - 1")
                foreach(l RANGE ${llast})
                    string(JSON label GET "${value}" ${l})
                    list(APPEND labels ${label})
                endforeach()
            endif()
        endforeach()
    endif()
    set(nclass 0)
    set(ntier 0)
    foreach(label IN LISTS labels)
        if(label IN_LIST CLASSES)
            math(EXPR nclass "${nclass} + 1")
        elseif(label IN_LIST tiers)
            math(EXPR ntier "${ntier} + 1")
        endif()
    endforeach()
    if(nclass EQUAL 0 OR NOT ntier EQUAL 1)
        message(SEND_ERROR "test ${name}: labels '${labels}' need a class (${CLASSES}) "
            "and one tier (${tiers}); add it to cmake/kin6d_test_labels.cmake")
        math(EXPR unlabelled "${unlabelled} + 1")
    endif()
endforeach()

list(LENGTH entries nsources)
if(violations GREATER 0 OR unlabelled GREATER 0)
    message(FATAL_ERROR "${violations} layering violation(s), "
        "${unlabelled} test(s) without class and tier labels")
endif()
message(STATUS "kin6d layering: ${nsources} sources, ${count} tests labelled")
