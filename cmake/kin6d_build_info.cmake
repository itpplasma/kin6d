# Build-time provenance: regenerate the Fortran include on every build, but
# rewrite it only when the recorded revision, dirty state or build identity
# changed. Inputs (-D): KIN6D_SOURCE_DIR, KIN6D_INFO_OUTPUT and the
# KIN6D_BUILD_* / KIN6D_*_REVISION strings listed in kin6d_info_names below.
execute_process(COMMAND git -C "${KIN6D_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE KIN6D_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE commit_status ERROR_QUIET)
if(NOT commit_status EQUAL 0)
    set(KIN6D_GIT_COMMIT "unavailable")
    set(KIN6D_GIT_DIRTY "unavailable")
else()
    execute_process(COMMAND git -C "${KIN6D_SOURCE_DIR}" status --porcelain
            --untracked-files=no
        OUTPUT_VARIABLE dirty_files OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE dirty_status ERROR_QUIET)
    if(NOT dirty_status EQUAL 0)
        set(KIN6D_GIT_DIRTY "unavailable")
    elseif(dirty_files STREQUAL "")
        set(KIN6D_GIT_DIRTY "clean")
    else()
        set(KIN6D_GIT_DIRTY "dirty")
    endif()
endif()
set(KIN6D_SOURCE_PATH "${KIN6D_SOURCE_DIR}")
set(kin6d_info_names KIN6D_GIT_COMMIT KIN6D_GIT_DIRTY KIN6D_SOURCE_PATH
    KIN6D_BUILD_TYPE KIN6D_BUILD_FLAGS KIN6D_BUILD_COMPILER
    KIN6D_FORTSYM_REVISION KIN6D_FORTNUM_REVISION KIN6D_FORTPLOT_REVISION
    KIN6D_FORTIO_REVISION KIN6D_FORTFEM_REVISION KIN6D_FORTSPARSE_REVISION
    KIN6D_LIBNEO_REVISION)
set(text "! Generated by cmake/kin6d_build_info.cmake; do not edit.\n")
foreach(name IN LISTS kin6d_info_names)
    string(TOLOWER "${name}" lower)
    set(value "${${name}}")
    string(APPEND text "character(len=*), parameter :: ${lower} = \"\"")
    string(LENGTH "${value}" remaining)
    set(offset 0)
    while(remaining GREATER 0)
        string(SUBSTRING "${value}" ${offset} 60 chunk)
        string(REPLACE "\"" "\"\"" chunk "${chunk}")
        string(APPEND text " // &\n    \"${chunk}\"")
        math(EXPR offset "${offset} + 60")
        math(EXPR remaining "${remaining} - 60")
    endwhile()
    string(APPEND text "\n")
endforeach()
if(EXISTS "${KIN6D_INFO_OUTPUT}")
    file(READ "${KIN6D_INFO_OUTPUT}" previous)
else()
    set(previous "")
endif()
if(NOT previous STREQUAL text)
    file(WRITE "${KIN6D_INFO_OUTPUT}" "${text}")
endif()
