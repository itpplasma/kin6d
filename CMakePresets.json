{
  "version": 3,
  "configurePresets": [
    {"name":"cpu","generator":"Ninja","binaryDir":"${sourceDir}/build",
     "cacheVariables":{"CMAKE_BUILD_TYPE":"Release","BUILD_TESTING":"ON",
      "KIN6D_CHECK_LEAN":"OFF","KIN6D_ENABLE_OPENMP":"ON"}},
    {"name":"debug","inherits":"cpu","binaryDir":"${sourceDir}/build-debug",
     "cacheVariables":{"CMAKE_BUILD_TYPE":"Debug",
      "CMAKE_Fortran_FLAGS_DEBUG":"-g -O0 -fcheck=all -fbacktrace"}},
    {"name":"formal","inherits":"cpu","binaryDir":"${sourceDir}/build-formal",
     "cacheVariables":{"KIN6D_CHECK_LEAN":"ON"}},
    {"name":"dev-fast","inherits":"cpu","binaryDir":"${sourceDir}/build-dev-fast",
     "cacheVariables":{"KIN6D_BUILD_EXTRAS":"OFF",
      "CMAKE_PROJECT_TOP_LEVEL_INCLUDES":"${sourceDir}/cmake/kin6d_shared_deps.cmake"}}
  ],
  "buildPresets": [{"name":"cpu","configurePreset":"cpu"},
                    {"name":"debug","configurePreset":"debug"},
                    {"name":"formal","configurePreset":"formal"},
                    {"name":"dev-fast","configurePreset":"dev-fast"}],
  "testPresets": [{"name":"cpu","configurePreset":"cpu","output":{"outputOnFailure":true}},
                   {"name":"debug","configurePreset":"debug","output":{"outputOnFailure":true}},
                   {"name":"formal","configurePreset":"formal","output":{"outputOnFailure":true}},
                   {"name":"native-sparse","configurePreset":"cpu",
                    "output":{"outputOnFailure":true},"execution":{"jobs":4},
                    "filter":{"include":{"name":"^(gs_free_boundary_t7_.*|gs_native_adapter_contract|grad_shafranov_csr_direct_newton_oracles|nonnested_coupled_solovev_p2|gs_free_boundary_t3_manufactured_newton|ideal_fb_derivatives|ideal_fb_vertical_newton|ideal_map_derivatives_and_rotation_null|ideal_map_reduced_omega_derivatives)$"}}},
                   {"name":"dev-fast","configurePreset":"dev-fast",
                    "output":{"outputOnFailure":true},
                    "execution":{"jobs":32},
                    "filter":{"exclude":{"label":"^slow$"}}},
                   {"name":"class","hidden":true,"configurePreset":"dev-fast",
                    "output":{"outputOnFailure":true},
                    "execution":{"jobs":32},
                    "filter":{"exclude":{"label":"^slow$"}}},
                   {"name":"core","inherits":"class","filter":{"include":{"label":"^core$"}}},
                   {"name":"fem2d","inherits":"class","filter":{"include":{"label":"^fem2d$"}}},
                   {"name":"pairs","inherits":"class","filter":{"include":{"label":"^pairs$"}}},
                   {"name":"equilibrium","inherits":"class","filter":{"include":{"label":"^equilibrium$"}}},
                   {"name":"mhd","inherits":"class","filter":{"include":{"label":"^mhd$"}}},
                   {"name":"classical","inherits":"class","filter":{"include":{"label":"^classical$"}}},
                   {"name":"quantum","inherits":"class","filter":{"include":{"label":"^quantum$"}}},
                   {"name":"continuum","inherits":"class","filter":{"include":{"label":"^continuum$"}}},
                   {"name":"apps","inherits":"class","filter":{"include":{"label":"^apps$"}}}]
}
